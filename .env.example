# LLM: any OpenAI-compatible endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Reranker (optional; falls back to a local cross-encoder when empty)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# Tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexvia-rag-platform
LANGSMITH_TRACING=true

# Vector store: leave QDRANT_URL empty to use embedded local mode under ./storage/qdrant
QDRANT_URL=
QDRANT_COLLECTION=enterprise_docs

# Retrieval tuning
RERANK_THRESHOLD=0.15
TOP_K_CANDIDATES=30
TOP_N_FINAL=5

# Demo auth: token -> role map (real auth is out of scope)
DEMO_TOKENS=finance-token:finance,research-token:research,hr-token:hr,employee-token:employee,admin-token:admin
